{
  "mcpServers": {
    "web-search": {
      "command": "npx",
      "args": ["-y", "open-websearch@latest"],
      "env": {
        "MODE": "stdio",
        "DEFAULT_SEARCH_ENGINE": "duckduckgo",
        "ALLOWED_SEARCH_ENGINES": "duckduckgo,bing,exa,brave,juejin,csdn,baidu,startpage"
      }
    }
  }
}
